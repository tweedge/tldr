[Unit]
Description=TLDR AXFR egress tunnel (SOCKS5 via clean-egress host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# -4 is mandatory: IPv6 to the egress host is broken from this LAN.
# Keepalives + Restart=always make this self-heal across the flaky path.
ExecStart=/usr/bin/ssh -4 -N -D 127.0.0.1:1080 \
    -i %h/.ssh/tldr_tunnel \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ConnectTimeout=10 \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=2 \
    -o TCPKeepAlive=yes \
    -o StrictHostKeyChecking=accept-new \
    ubuntu@132.145.97.253
Restart=always
# Long backoff avoids tripping fail2ban on the egress host when the path flaps.
RestartSec=45

[Install]
WantedBy=default.target
